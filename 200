<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Docerola Studio</title>

  <!-- Tailwind CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-slate-900 text-white">
  <div id="root"></div>

  <!-- Si tu JS exporta como componente React, necesitas React + ReactDOM -->
  <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>

  <!-- Libraries CDN (opcionales si tu minificado ya hace import dinámico) -->
  <script src="https://cdn.jsdelivr.net/npm/tone@14.7.77/build/Tone.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/midiwriter-js@2.1.0/build/index.umd.js"></script>

  <!-- Tu código minificado (asegúrate que DocerolaStudio.min.js exporte/monte la app en #root) -->
  <script type="module" src="DocerolaStudio.min.js"></script>

  <!-- Si tu bundle exporta un componente, usa este pequeño bootstrapper -->
  <script>
    // Bootstrapping robusto: espera a React/ReactDOM, detecta mount function o componente global
    (function waitForMount() {
      // Espera hasta que React y ReactDOM estén definidos
      if (typeof React === 'undefined' || typeof ReactDOM === 'undefined') {
        return setTimeout(waitForMount, 50);
      }

      const rootEl = document.getElementById('root');
      if (!rootEl) {
        console.error('Elemento #root no encontrado');
        return;
      }

      // Caso 1: bundle ofrece una función de montaje global
      if (window.DocerolaStudioMount && typeof window.DocerolaStudioMount === 'function') {
        try {
          window.DocerolaStudioMount(rootEl);
        } catch (err) {
          console.error('Error ejecutando DocerolaStudioMount:', err);
        }
        return;
      }

      // Caso 2: bundle expone un componente React global
      if (window.DocerolaStudio) {
        const e = React.createElement;
        try {
          if (typeof ReactDOM.createRoot === 'function') {
            ReactDOM.createRoot(rootEl).render(e(window.DocerolaStudio));
          } else if (typeof ReactDOM.render === 'function') {
            ReactDOM.render(e(window.DocerolaStudio), rootEl);
          } else {
            console.error('No se dispone de métodos de montaje en ReactDOM');
          }
        } catch (err) {
          console.error('Error montando window.DocerolaStudio:', err);
        }
        return;
      }

      // Si llegamos aquí, el bundle no expuso las globals esperadas todavía
      // Reintentamos un par de veces más (evita loop infinito)
      const retries = (waitForMount._retries = (waitForMount._retries || 0) + 1);
      if (retries < 40) { // ~2 segundos
        setTimeout(waitForMount, 50);
      } else {
        console.error('DocerolaStudio no disponible en window. Asegúrate de que DocerolaStudio.min.js exponga window.DocerolaStudio o window.DocerolaStudioMount, o que la ruta del script sea correcta (ver Network).');
      }
    })();
  </script>
</body>
</html>
